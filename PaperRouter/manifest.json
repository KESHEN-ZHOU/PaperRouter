{
    "manifest_version": 2,
    "name": "PaperRouter",
    "version": "0.2.1",
    "description": "Suggests Zotero collections for your papers via LLM or embedding similarity.",
    "homepage_url": "https://github.com/KESHEN-ZHOU/PaperRouter",
    "applications": {
        "zotero": {
            "id": "paperrouter@keshen-zhou.github.io",
            "update_url": "https://raw.githubusercontent.com/KESHEN-ZHOU/PaperRouter/main/updates.json",
            "strict_min_version": "7.0",
            "strict_max_version": "9.*"
        }
    },
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
    }
}
